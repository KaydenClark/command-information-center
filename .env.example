# Command Information Center — environment template.
# Copy to .env (gitignored) and fill in real values for the features you want.
# With NO credentials set, the app still runs in demo mode against data.js and
# renders deterministic fallback states instead of any AI output.

# ---- Server ----
# Bootstrap-only absolute path to the canonical runtime directory when code runs
# from an isolated checkout. Inject it before startup; blank uses this checkout.
CIC_RUNTIME_ROOT=
PORT=8787
HOST=0.0.0.0

# Local SQLite path (task board, source status). Auto-created on first run.
CIC_DB=./data/cic.sqlite

# Dashboard feed file the server reads. Defaults to data.js.
# In demo mode: cp data.example.js data.js
CIC_DATA_FEED=data.js

# Optional cached health report written by the sibling Personal Intelligence Platform.
# PLATFORM_HEALTH_REPORT=../Personal Intelligence Platform/.local/platform-health.json
PLATFORM_HEALTH_MAX_AGE_MINUTES=90

# Optional sanitized Audit Engine harness-flow export rendered read-only on the
# Harness view. When unset, CIC uses the committed synthetic fixture. A relative
# override resolves from CIC_RUNTIME_ROOT.
# CIC_HARNESS_REPORT=.local/harness-flow-export.json
CIC_HARNESS_REPORT_MAX_AGE_MINUTES=90

# Optional local-app passcode gate. If unset, the API is open (fine for localhost).
# The server only ever stores the SHA-256 hash; the plaintext stays in this file.
CIC_PASSCODE=change-this-local-passcode
# Alternatively supply a precomputed hash and omit CIC_PASSCODE:
# CIC_PASSCODE_HASH=

# Workbench releases are handed to the fixed GPT_OS Captain worker.
# Captain uses the Mac Mini gh Keychain session; CIC accepts no GitHub credential.

# ---- Gmail refresh worker (optional) ----
GMAIL_REFRESH_INTERVAL_MINUTES=180
# Optional command run before Gmail task suggestions are re-read from the feed.
# GMAIL_REFRESH_COMMAND=/absolute/path/to/refresh-command

# ---- Spotify Atlas link (optional) ----
# Pins the Music page's "open Atlas" link. Empty derives http://<host>:8899/dashboard.html
ATLAS_URL=

# ---- Personal-data intelligence synthesis (optional) ----
# Server-side only. The browser never receives these keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Cost controls for the AI Intelligence overview. The overview synthesis is the
# only paid OpenAI call on a normal dashboard mount.
# CIC_INTELLIGENCE_TTL_MS: how long (ms) a successful synthesis is reused before
# a fresh one is generated. Default 1800000 (30 min). The manual Refresh control
# always bypasses this cache.
CIC_INTELLIGENCE_TTL_MS=1800000
# CIC_INTELLIGENCE_AUTOSYNTH: set to "off" to disable auto-on-mount synthesis and
# serve the deterministic local fallback at zero OpenAI cost; Refresh still
# synthesizes on demand. Any other value (default "on") keeps auto-synthesis.
CIC_INTELLIGENCE_AUTOSYNTH=on

# ---- OpenBrain / Supabase retrieval (optional) ----
# See CONTRACT.md for the tables and RPCs the backend must expose.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role (secret) key — server-side only. SUPABASE_SECRET_KEY is accepted as an alias.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# Optional query-wiki edge function (used instead of direct Supabase RPC when set).
QUERY_WIKI_URL=
QUERY_WIKI_ACCESS_TOKEN=
OPENBRAIN_MATCH_COUNT=8
OPENBRAIN_MATCH_THRESHOLD=0.2

# ---- Spotify Web API controls (optional) ----
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/spotify/callback
SPOTIFY_REFRESH_TOKEN=
# Timeout in milliseconds for Spotify API calls (default 2500).
# SPOTIFY_REQUEST_TIMEOUT_MS=2500
