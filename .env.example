PORT=8787
HOST=0.0.0.0
CIC_DB=./data/cic.sqlite
CIC_PASSCODE=change-this-local-passcode
GMAIL_REFRESH_INTERVAL_MINUTES=180

# Optional: a command that refreshes data.js before Gmail suggestions are read.
# GMAIL_REFRESH_COMMAND=

# Optional Spotify Web API controls. Store real values only in local .env.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/spotify/callback
SPOTIFY_REFRESH_TOKEN=
