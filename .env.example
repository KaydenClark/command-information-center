PORT=8787
HOST=::
CIC_DB=./data/cic.sqlite
CIC_PASSCODE=change-this-local-passcode
GMAIL_REFRESH_INTERVAL_MINUTES=180

# Optional: a command that refreshes data.js before Gmail suggestions are read.
# GMAIL_REFRESH_COMMAND=

# Optional: Spotify Atlas dashboard URL. Empty derives from the browser host on port 8899.
ATLAS_URL=

# Optional: Personal data intelligence synthesis. Keep real keys in local .env only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: OpenBrain/Supabase retrieval. Service role keys stay server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
QUERY_WIKI_URL=
QUERY_WIKI_ACCESS_TOKEN=
OPENBRAIN_MATCH_COUNT=8
OPENBRAIN_MATCH_THRESHOLD=0.2

# Optional Spotify Web API controls. Store real values only in local .env.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/spotify/callback
SPOTIFY_REFRESH_TOKEN=
